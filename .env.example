# Copy to .env and fill in. Every value here is validated at boot by
# apps/api/src/config/env.ts — the process refuses to start in production if a
# required secret is missing, rather than falling back to a default.

NODE_ENV=development
PORT=4000

# --- Required in production -------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/codeforge?schema=public
REDIS_URL=redis://localhost:6379

# Minimum 32 characters, and the two must differ.
# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# --- Tokens -----------------------------------------------------------------
JWT_ISSUER=codeforge-api
JWT_AUDIENCE=codeforge-web
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# --- HTTP -------------------------------------------------------------------
# Exact-match allowlist; '*' is rejected in production.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Enable only behind a trusted proxy, otherwise clients can spoof their IP.
TRUST_PROXY=false
BODY_LIMIT=256kb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

# --- Audit ------------------------------------------------------------------
AUDIT_RETENTION_DAYS=90
# AUDIT_DIR=/var/lib/codeforge/audit

# --- Optional: OIDC SSO (all four required together, or none) ---------------
# OIDC_ISSUER=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=

# --- Optional: SCIM provisioning (endpoints refuse traffic when unset) ------
# SCIM_BEARER_TOKEN=

# --- Optional: SMTP (all four required together, or none) -------------------
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
SMTP_FROM=no-reply@codeforge.local

# --- Sandbox execution limits ----------------------------------------------
EXEC_CPU_TIME_MS=5000
EXEC_MEMORY_MB=128
EXEC_PROCESSES_MAX=10
EXEC_FDS_MAX=256

PUPPETEER_POOL_SIZE=2
LOG_LEVEL=info
